<Window x:Class="Ognia.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Ognia.Wpf.Views.Shell"
        Title="Ognia"
        Width="1200" Height="800"
        MinWidth="1200" MinHeight="800"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        Icon="/Assets/Brand/Icon/Ognia.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="8"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootChrome"
            CornerRadius="12"
            Background="{DynamicResource BackgroundColor}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0"
                    x:Name="TitleBar"
                    Height="50"
                    Background="{DynamicResource BackgroundColor}"
                    WindowChrome.IsHitTestVisibleInChrome="False">
                <TextBlock Text="{Binding DisplayTitle}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource DisabledTextColor}"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button Content="▣"
                            Click="MiniButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="32" Height="30"
                            FontSize="14"
                            Cursor="Hand"
                            Foreground="{DynamicResource LightTextColor}"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="Mini player"/>
                    <Button Content="—"
                            Click="MinimizeButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="32" Height="30"
                            FontSize="14"
                            Cursor="Hand"
                            Foreground="{DynamicResource LightTextColor}"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="Minimize"/>
                    <Button Content="▢"
                            Click="MaximizeButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="32" Height="30"
                            FontSize="14"
                            Cursor="Hand"
                            Foreground="{DynamicResource LightTextColor}"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="Maximize"/>
                    <Button Content="✕"
                            Click="CloseButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="32" Height="30"
                            FontSize="14"
                            Cursor="Hand"
                            Foreground="{DynamicResource LightTextColor}"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- Main Content -->
            <ContentControl x:Name="MainContent" Grid.Row="1" />
            
            <!-- Always Visible -->
            <shell:StatusBarView Grid.Row="2" />
        </Grid>
    </Border>
</Window>