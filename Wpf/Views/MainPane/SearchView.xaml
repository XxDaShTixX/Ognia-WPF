<UserControl x:Class="Ognia.Wpf.Views.MainPane.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <DockPanel Style="{StaticResource PrimaryDockPanel}">

            <TextBlock DockPanel.Dock="Top"
                       Text="Search"
                       Style="{StaticResource TitleText}"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,10"/>

            <StackPanel DockPanel.Dock="Top"
                        Orientation="Horizontal"
                        Margin="0,0,0,8">
                <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         Width="400"
                         KeyDown="QueryBox_KeyDown"/>
                <Button Content="Search"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Top"
                        Orientation="Horizontal"
                        Margin="0,0,0,8">
                <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         Width="400"
                         KeyDown="QueryBox_KeyDown"/>
                <Button Content="Search"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource PrimaryButton}"/>

                <TextBlock Text="Per page"
                           VerticalAlignment="Center"
                           Margin="16,0,6,0"
                           Style="{StaticResource PrimaryTextBlock}"/>
                <ComboBox Width="80"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding PageSizeOptions}"
                          SelectedItem="{Binding PageSize, Mode=TwoWay}"/>
            </StackPanel>

            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding Status}"
                       Margin="0,0,0,8"
                       Foreground="{DynamicResource DisabledTextColor}"
                       Style="{StaticResource PrimaryTextBlock}"/>

            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding Status}"
                       Margin="0,0,0,8"
                       Foreground="{DynamicResource DisabledTextColor}"
                       Style="{StaticResource PrimaryTextBlock}"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource HoverTile}" Margin="0,2" Padding="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Result Image -->
                                    <Border Grid.Column="0"
                                            Width="60" Height="60"
                                            CornerRadius="4"
                                            ClipToBounds="True"
                                            Background="{DynamicResource TextboxBackgroundColor}"
                                            Margin="0,0,10,0"
                                            Cursor="Hand"
                                            Tag="{Binding SourceUrl}"
                                            MouseLeftButtonUp="Thumbnail_Click">
                                        <Image Source="{Binding ThumbnailUrl, Converter={StaticResource StringToImageSource}}"
                                               Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- Result Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource PrimaryTextBlock}">
                                                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextColor}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource LightTextColor}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding DurationLabel}"
                                                   Foreground="{DynamicResource DisabledTextColor}"
                                                   FontSize="12"/>
                                    </StackPanel>

                                    <!-- Play Button (Preview)-->
                                    <Button Grid.Column="2"
                                            Content="▶"
                                            Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButton}"
                                            Width="32" Height="32"
                                            Margin="0,0,6,0"
                                            ToolTip="Preview"/>

                                    <!-- Playlist Dropdown -->
                                    <ComboBox Grid.Column="3"
                                              Width="160"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center"
                                              ItemsSource="{Binding Playlists}"
                                              SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <!-- Add Button -->
                                    <Button Grid.Column="4"
                                            Content="Add"
                                            Command="{Binding DataContext.AddToPlaylistCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PrimaryButton}"
                                            Width="60" Height="30"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0">
                <Button Content="◀ Prev"
                        Command="{Binding PrevPageCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="100"/>
                <TextBlock Text="{Binding PageLabel}"
                           VerticalAlignment="Center"
                           Margin="12,0"
                           Style="{StaticResource PrimaryTextBlock}"/>
                <Button Content="Next ▶"
                        Command="{Binding NextPageCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="100"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>