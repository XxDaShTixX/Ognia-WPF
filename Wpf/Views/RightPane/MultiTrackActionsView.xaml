<UserControl x:Class="Ognia.Wpf.Views.RightPane.MultiTrackActionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            
            <!-- Track Count Selected -->
            <TextBlock Text="{Binding Header}"
                       Style="{StaticResource SubtitleText}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"/>

            <Separator/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <!-- Remove from Playlist -->
                <Button Content="🗙"
                        FontSize="16"
                        Command="{Binding RemoveCommand}"
                        Style="{StaticResource IconButton}"
                        HorizontalAlignment="Center"
                        ToolTip="Remove track from playlist"/>

                <!-- Download -->
                <Button Content="⤓"
                        FontSize="20"
                        Command="{Binding DownloadCommand}"
                        Style="{StaticResource IconButton}"
                        HorizontalAlignment="Center"
                        ToolTip="Download track"/>

                <!-- Remove Download -->
                <Button Content="━"
                        FontSize="20"
                        Command="{Binding RemoveDownloadCommand}"
                        Style="{StaticResource IconButton}"
                        HorizontalAlignment="Center"
                        ToolTip="Remove download"/>
            </StackPanel>
            

            <Separator/>

            <!-- Copy to Playlist -->
            <TextBlock Text="Copy to Playlist"
                       HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center">
                <ComboBox ItemsSource="{Binding PlaylistTargets}"
                          SelectedItem="{Binding CopyTarget, Mode=TwoWay}"
                          Width="150">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="⧉"
                        Command="{Binding CopyCommand}"
                        Style="{StaticResource IconButton}"
                        ToolTip="Copy tracks to playlist"/>
            </StackPanel>

            <Separator/>

            <!-- Move to Playlist -->
            <TextBlock Text="Move to Playlist"
                       HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center">
                <ComboBox ItemsSource="{Binding PlaylistTargets}"
                          SelectedItem="{Binding MoveTarget, Mode=TwoWay}"
                          Width="150">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="→"
                        Command="{Binding MoveCommand}"
                        Style="{StaticResource IconButton}"
                        ToolTip="Move tracks to playlist"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>