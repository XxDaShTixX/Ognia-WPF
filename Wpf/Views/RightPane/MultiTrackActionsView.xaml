<UserControl x:Class="Ognia.Wpf.Views.RightPane.MultiTrackActionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            
            <!-- Track Count Selected -->
            <TextBlock Text="{Binding Header}"
                       Style="{StaticResource SubtitleText}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"/>

            <Separator/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <!-- Remove from Playlist -->
                <Button Content="🗙"
                        FontSize="16"
                        Command="{Binding RemoveCommand}"
                        Style="{StaticResource IconButton}"
                        HorizontalAlignment="Center"
                        ToolTip="Remove track from playlist"/>

                <!-- Download -->
                <Button Content="⤓"
                        FontSize="20"
                        Command="{Binding DownloadCommand}"
                        Style="{StaticResource IconButton}"
                        HorizontalAlignment="Center"
                        ToolTip="Download track"/>

                <!-- Remove Download -->
                <Button Content="━"
                        FontSize="20"
                        Command="{Binding RemoveDownloadCommand}"
                        Style="{StaticResource IconButton}"
                        HorizontalAlignment="Center"
                        ToolTip="Remove download"/>
            </StackPanel>
            

            <Separator/>

            <!-- Copy to Playlist -->
            <TextBlock Text="Copy to Playlist"
                       Style="{StaticResource PrimaryTextBlock}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>
            <ComboBox ItemsSource="{Binding PlaylistTargets}"
                      SelectedItem="{Binding CopyTarget, Mode=TwoWay}"
                      Width="200"
                      HorizontalAlignment="Center">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Copy"
                    Command="{Binding CopyCommand}"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Center"
                    Width="200"/>

            <Separator/>

            <!-- Move to Playlist -->
            <TextBlock Text="Move to Playlist"
                       Style="{StaticResource PrimaryTextBlock}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>
            <ComboBox ItemsSource="{Binding PlaylistTargets}"
                      SelectedItem="{Binding MoveTarget, Mode=TwoWay}"
                      Width="200"
                      HorizontalAlignment="Center">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Move"
                    Command="{Binding MoveCommand}"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Center"
                    Width="200"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>