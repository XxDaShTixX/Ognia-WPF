<UserControl x:Class="Ognia.Wpf.Views.Shell.MainPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PaneBorder}"
            CornerRadius="10"
            Margin="10"
            Padding="10"
            ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                <GradientStop Color="{DynamicResource SidebarBackgroundColor.Color}" Offset="0"/>
                <GradientStop Color="{DynamicResource FadeMainPaneColor.Color}" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <ContentControl x:Name="HostContent"/>
    </Border>
</UserControl>