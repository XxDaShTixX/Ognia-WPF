<UserControl x:Class="Ognia.Wpf.Views.MainPane.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <DockPanel Style="{StaticResource PrimaryDockPanel}">

            <!-- Header: title + create button -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                
                <!-- Title -->
                <TextBlock Text="Library"
                           Style="{StaticResource TitleText}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>
                
                <!-- Add Button -->
                <Button Content="+"
                        Command="{Binding BeginCreatePlaylistCommand}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="24"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip="Create playlist">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4"
                                                SnapsToDevicePixels="True">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Margin="0,0,0,2"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Session.IsCreatingPlaylist}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </DockPanel>

            <!-- Loading -->
            <TextBlock DockPanel.Dock="Top" Text="Loading..."
                       Visibility="{Binding Session.IsLoading, Converter={StaticResource BoolToVisibility}}"/>

            <!-- New Playlist -->
            <Border DockPanel.Dock="Top"
                    Margin="0,0,0,10"
                    Padding="10"
                    CornerRadius="8"
                    Background="{DynamicResource SidebarBackgroundColor}"
                    Visibility="{Binding Session.IsCreatingPlaylist, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="New playlist name"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBox Text="{Binding Session.NewPlaylistName, UpdateSourceTrigger=PropertyChanged}"
                                 Width="300"/>
                        <Button Content="✓"
                                Command="{Binding ConfirmCreatePlaylistCommand}"
                                Style="{StaticResource IconButton}"
                                ToolTip="Create"/>
                        <Button Content="✕"
                                Command="{Binding CancelCreatePlaylistCommand}"
                                Style="{StaticResource IconButton}"
                                ToolTip="Cancel"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Playlists -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PlaylistsControl"
                              ItemsSource="{Binding Session.Playlists}"
                              AllowDrop="True"
                              PreviewMouseLeftButtonDown="PlaylistsControl_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="PlaylistsControl_PreviewMouseMove"
                              DragOver="PlaylistsControl_DragOver"
                              Drop="PlaylistsControl_Drop">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8" Width="160" Height="160">
                                <Border CornerRadius="12" Cursor="Hand"
                                        Style="{StaticResource HoverTile}"
                                        Background="{DynamicResource SidebarBackgroundColor}"
                                        Tag="{Binding}"
                                        MouseLeftButtonUp="PlaylistTile_Click">
                                    <Border.Clip>
                                        <RectangleGeometry RadiusX="12" RadiusY="12" Rect="0,0,160,160"/>
                                    </Border.Clip>
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <Border Width="120" Height="120" HorizontalAlignment="Center"
                                CornerRadius="8" ClipToBounds="True"
                                Background="{DynamicResource TextBoxBackgroundColor}">
                                                <Border.Clip>
                                                    <RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,120,120"/>
                                                </Border.Clip>
                                                <Grid>
                                                    <Image Source="{Binding CachedCoverPath, Converter={StaticResource StringToImageSource}}"
                                                           Stretch="UniformToFill"/>

                                                    <Grid>
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CachedCoverPath}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding CachedCoverPath}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <TextBlock Text="♪"
                                               FontSize="48"
                                               Foreground="{DynamicResource DisabledTextColor}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <!-- Hover-only delete button -->
                                        <Button Content="🗑"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Width="28" Height="28"
                                                Margin="4"
                                                FontSize="14"
                                                Cursor="Hand"
                                                BorderThickness="0"
                                                ToolTip="Delete playlist"
                                                Tag="{Binding}"
                                                Click="PlaylistDelete_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Background" Value="#CC000000"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorTextColor}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="6"
                                                                        SnapsToDevicePixels="True">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ErrorBackgroundColor}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>