<UserControl x:Class="Ognia.Wpf.Views.MainPane.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <DockPanel Style="{StaticResource PrimaryDockPanel}" LastChildFill="False">
            <!-- Search Title -->
            <TextBlock DockPanel.Dock="Top"
                       Text="Search"
                       Style="{StaticResource TitleText}"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,10"/>

            <!-- Search Section -->
            <StackPanel DockPanel.Dock="Top"
                        Orientation="Horizontal"
                        Margin="0,0,0,8">
                <!-- Search Textbox-->
                <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         Width="400"
                         KeyDown="QueryBox_KeyDown"/>
                <!-- Search Button -->
                <Button Content="🔎"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource IconButton}"/>
                
                <!-- Results count per page-->
                <TextBlock Text="Results"
                           VerticalAlignment="Center"
                           Margin="15,0,05,0"/>
                <ComboBox Width="80"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding PageSizeOptions}"
                          SelectedItem="{Binding PageSize, Mode=TwoWay}"/>
            </StackPanel>
            
            <!-- Status Textbox -->
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding Status}"
                       Margin="0,0,0,8"
                       Foreground="{DynamicResource DisabledTextColor}"/>

            <!-- Bottom bar: declare BEFORE the ScrollViewer -->
            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0">

                <!-- Previous Button -->
                <Button Content="◀"
                        Style="{StaticResource IconButton}"/>

                <!-- Page Label -->
                <TextBlock Text="{Binding PageLabel}"
                           VerticalAlignment="Center"
                           Margin="12,0"/>

                <!-- Next Button -->
                <Button Content="▶"
                        Command="{Binding NextPageCommand}"
                        Style="{StaticResource IconButton}"/>
            </StackPanel>

            <ListBox DockPanel.Dock="Top"
                     ItemsSource="{Binding Results}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionMode="Single">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem"
                           BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid Height="45"
                                      HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Result Image -->
                                    <Border Grid.Column="0"
                                            Width="40" Height="40"
                                            CornerRadius="4"
                                            ClipToBounds="True"
                                            Background="{DynamicResource TextboxBackgroundColor}"
                                            Margin="5,5,10,0"
                                            Cursor="Hand">
                                        <Grid>
                                            <Image Source="{Binding ThumbnailUrl, Converter={StaticResource StringToImageSource}}"
                                                   Stretch="UniformToFill"
                                                   Tag="{Binding SourceUrl}"
                                                   MouseLeftButtonUp="Thumbnail_Click"/>
                                            <Button Content="▶"
                                                    Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Preview">
                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource IconButton}">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
                                                                         Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Setter Property="Background" Value="Transparent"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Result Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource PrimaryTextBlock}">
                                                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextColor}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource LightTextColor}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding DurationLabel}"
                                                   Foreground="{DynamicResource DisabledTextColor}"
                                                   FontSize="12"/>
                                    </StackPanel>

                                    <!-- Track Add/Remove from Playlist -->
                                    <Button x:Name="AddButton"
                                            Grid.Column="2"
                                            FontSize="20"
                                            Height="30" Width="30"
                                            ToolTip="Add or remove from playlists"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Content="{Binding PlaylistButtonGlyph}"
                                            Command="{Binding OpenPlaylistPickerCommand}"
                                            Style="{StaticResource IconButton}"/>

                                    <!-- Playlist Popup -->
                                    <Popup PlacementTarget="{Binding ElementName=AddButton}"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           AllowsTransparency="True"
                                           IsOpen="{Binding IsPlaylistPickerOpen, Mode=TwoWay}">

                                        <Border Background="{DynamicResource SidebarBackgroundColor}"
                                                BorderBrush="{DynamicResource ButtonBorderColor}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8"
                                                Width="240">
                                            <StackPanel>
                                                <!-- Popup title -->
                                                <TextBlock Text="Playlists"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,6"/>

                                                <Separator Margin="0,0,0,6"/>

                                                <!-- Playlists containing the track -->
                                                <TextBlock Text="Remove From"
                                                           FontWeight="Bold"
                                                           Margin="0,0,0,5"/>

                                                <ItemsControl ItemsSource="{Binding ExistingPlaylists}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Name}"
                                                                           VerticalAlignment="Center"/>
                                                                <CheckBox Grid.Column="1"
                                                                          IsChecked="{Binding IsInPlaylist, Mode=OneWay}"
                                                                    Command="{Binding DataContext.TogglePlaylistCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                          VerticalAlignment="Center"
                                                                          Margin="8,0,0,0"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Separator Margin="0,6"/>

                                                <!-- Playlists not containing the track -->
                                                <TextBlock Text="Add to"
                                                           FontWeight="Bold"
                                                           Margin="0,0,0,5"/>

                                                <ItemsControl ItemsSource="{Binding OtherPlaylists}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Name}"
                                                                           VerticalAlignment="Center"/>
                                                                <CheckBox Grid.Column="1"
                                                                          IsChecked="{Binding IsInPlaylist, Mode=OneWay}"
                                                                          Command="{Binding DataContext.TogglePlaylistCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                          CommandParameter="{Binding}"
                                                                          VerticalAlignment="Center"
                                                                          Margin="8,0,0,0"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                
                                                <!-- Loading -->
                                                <TextBlock Text="Loading..."
                                                           Foreground="{DynamicResource DisabledTextColor}"
                                                           Visibility="{Binding IsLoadingPlaylists, Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <Rectangle Height="1"
                                           Opacity="0.25"
                                           Fill="{DynamicResource SeparatorColor}"/>
                            </StackPanel>
                        </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>