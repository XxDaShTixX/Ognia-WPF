<UserControl x:Class="Ognia.Wpf.Views.Shell.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Ognia.Wpf.Views.Shell">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="RightColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <views:LeftPaneView x:Name="LeftPane"  Grid.Row="0" Grid.Column="0" DataContext="{Binding Left}"/>
        <views:MainPaneView x:Name="MainPane" Grid.Row="0" Grid.Column="1"/>
        <views:RightPaneView x:Name="RightPane" Grid.Row="0" Grid.Column="2"/>

        <Border Grid.Row="1" Grid.ColumnSpan="3"
                Background="{DynamicResource SidebarBackgroundColor}"
                CornerRadius="10"
                Margin="10"
                Padding="10"
                ClipToBounds="True">
            <ContentControl x:Name="PlaybackContent"/>
        </Border>
    </Grid>
</UserControl>