<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <SupportedOSPlatformVersion>6.1</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Ognia.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <ApplicationIcon>Assets\Brand\Icon\Ognia.ico</ApplicationIcon>
    <StartupObject>Ognia.Wpf.Program</StartupObject>
    <AssemblyVersion>0.2.3</AssemblyVersion>
    <FileVersion>0.2.3</FileVersion>
  </PropertyGroup>
  
  <ItemGroup>
    <Resource Include="Assets\Brand\Icon\Ognia.ico" />
    <Resource Include="Assets\Brand\Logo\Ognia.png" />
    <Resource Include="Assets\Brand\Logo\Ognia-Transparent.png" />
    <EmbeddedResource Include="Themes\Default.json" />
    <EmbeddedResource Include="Themes\Dark.json" />
    <EmbeddedResource Include="Themes\Light.json" />
    <Page Include="Themes\Default.json">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="YoutubeExplode" Version="6.6.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\MainPane\LibraryView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\Shell\MainPaneView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\Shell\RightPaneView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\Shell\PlaybackBarView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

</Project>
