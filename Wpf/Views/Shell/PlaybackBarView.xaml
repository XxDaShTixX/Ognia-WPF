<UserControl x:Class="Ognia.Wpf.Views.Shell.PlaybackBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Height="100">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: thumbnail spanning full height -->
        <Border Grid.Column="0" Width="100"
                Style="{StaticResource HoverTile}"
                Background="{DynamicResource TextboxBackgroundColor}"
                CornerRadius="6" Margin="0,0,10,0"
                VerticalAlignment="Stretch"
                Cursor="Hand"
                MouseLeftButtonUp="Thumbnail_Click">
            <Border.Clip>
                <RectangleGeometry RadiusX="6" RadiusY="6" Rect="0,0,100,100"/>
            </Border.Clip>
            <Image Source="{Binding PlaybackViewModel.NowPlayingThumbnail, Converter={StaticResource StringToImageSource}}"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </Border>

        <!-- Right: everything else, stacked vertically -->
        <DockPanel Grid.Column="1">
            <!-- Playback Controls -->
            <Grid DockPanel.Dock="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Playback buttons (center) -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal"
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">

                    <Button Command="{Binding PlaybackViewModel.PreviousCommand}"
                            Style="{StaticResource IconButton}" 
                            ToolTip="Play previous track.">
                        <TextBlock Text="◀◀"/>
                    </Button>

                    <Button Command="{Binding PlaybackViewModel.PlayPauseCommand}"
                            Style="{StaticResource IconButton}"
                            ToolTip="Play/Pause">
                        <TextBlock Text="{Binding PlaybackViewModel.PlayPauseLabel}"
                                   FontSize="15"
                                   Padding="0,0,0,3"/>
                    </Button>

                    <Button Command="{Binding PlaybackViewModel.StopCommand}"
                            Style="{StaticResource IconButton}"
                            ToolTip="Stop track.">
                        <TextBlock Text="■" FontSize="15"/>
                    </Button>

                    <Button Command="{Binding PlaybackViewModel.NextCommand}"
                            Style="{StaticResource IconButton}" 
                            ToolTip="Play next track.">
                        <TextBlock Text="▶▶"/>
                    </Button>

                    <Button Command="{Binding PlaybackViewModel.CycleRepeatCommand}"
                            Style="{StaticResource IconButton}" 
                            ToolTip="Repeat All/One/OFF.">
                        <TextBlock FontSize="20"
                                   Text="{Binding PlaybackViewModel.RepeatLabel}"/>
                    </Button>

                    <Button Command="{Binding PlaybackViewModel.ToggleShuffleCommand}"
                            Style="{StaticResource IconButton}" 
                            ToolTip="Shuffle ON/OFF.">
                        <TextBlock FontSize="20"
                                   Text="{Binding PlaybackViewModel.ShuffleLabel}"/>
                    </Button>

                </StackPanel>

                <!-- Volume (right) -->
                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal"
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center">

                    <Button Command="{Binding PlaybackViewModel.ToggleMuteCommand}"
                            Style="{StaticResource IconButton}" ToolTip="Mute/Unmute volume.">
                        <TextBlock FontSize="15"
                                   Text="{Binding PlaybackViewModel.VolumeIcon}"/>
                    </Button>

                    <Slider Width="150" Minimum="0" Maximum="1"
                            Value="{Binding PlaybackViewModel.Volume, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            IsMoveToPointEnabled="True"
                            ToolTip="Adjust volume."/>
                </StackPanel>
            </Grid>

            <!-- Now Playing -->
            <TextBlock DockPanel.Dock="Bottom"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding PlaybackViewModel.NowPlaying, StringFormat='Now playing: {0}'}"/>

            <!-- Seek slider -->
            <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Width="50"
                           VerticalAlignment="Center" 
                           Text="{Binding PlaybackViewModel.PositionLabel}"/>

                <Slider Grid.Column="1"
                    Minimum="0"
                    Maximum="{Binding PlaybackViewModel.TotalDuration, Converter={StaticResource TimeSpanToSecondsConverter}}"
                    Value="{Binding PlaybackViewModel.CurrentPosition, Mode=TwoWay, Converter={StaticResource TimeSpanToSecondsConverter}}"
                    VerticalAlignment="Center"
                    IsMoveToPointEnabled="True"
                    Thumb.DragStarted="Slider_DragStarted"
                    Thumb.DragCompleted="Slider_DragCompleted"/>

                <TextBlock Grid.Column="2" 
                           VerticalAlignment="Center" 
                           Margin="10,0,0,0"
                           Text="{Binding PlaybackViewModel.DurationLabel}"/>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
