<UserControl x:Class="Ognia.Wpf.Views.Shell.LeftPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding Left, RelativeSource={RelativeSource AncestorType=UserControl}}">

    <Border Style="{StaticResource PaneBorder}"
            CornerRadius="10" Margin="10" ClipToBounds="True">
        
        <DockPanel Style="{StaticResource SidebarDockPanel}">

            <DockPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                <TextBlock Text="{Binding WelcomeText}"
                           TextWrapping="Wrap"
                           Style="{StaticResource TitleText}"/>
            </DockPanel>

            <Separator DockPanel.Dock="Top" Width="200"/>

            <StackPanel DockPanel.Dock="Top">
                <Button Command="{Binding LibraryCommand}"
                        ToolTip="Library / Playlists"
                        Style="{StaticResource NavigationButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📚" Margin="0,0,10,0"/>
                        <TextBlock Text="Library"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding SearchCommand}"
                        ToolTip="Search"
                        Style="{StaticResource NavigationButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔎" Margin="0,0,10,0"/>
                        <TextBlock Text="Search"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding SettingsCommand}"
                        ToolTip="Settings Menu"
                        Style="{StaticResource NavigationButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙️" Margin="0,0,10,0"/>
                        <TextBlock Text="Settings"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Text="Loading..."
                       VerticalAlignment="Center"
                       Visibility="{Binding Session.IsLoading, Converter={StaticResource BoolToVisibility}}"/>

        </DockPanel>
        
    </Border>
    
</UserControl>