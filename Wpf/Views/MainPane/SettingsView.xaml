<UserControl x:Class="Ognia.Wpf.Views.MainPane.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <DockPanel Style="{StaticResource PrimaryDockPanel}">

            <TextBlock DockPanel.Dock="Top"
                       Text="Settings"
                       Style="{StaticResource TitleText}"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,10"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                
                <StackPanel>

                    <!-- Account -->
                    <TextBlock Text="Account"
                               HorizontalAlignment="Center"
                               Style="{StaticResource SubtitleText}"/>

                    <TextBlock Text="{Binding Email, StringFormat='Signed in as {0}'}"
                               HorizontalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        
                        <Button Content="Upgrade Account"
                                Click="Upgrade_Click"
                                ToolTip="Upgrade guest to account (coming soon)"
                                Visibility="{Binding IsGuestMode, Converter={StaticResource BoolToVisibility}}"/>

                        <Button Content="Log Out"
                                Command="{Binding LogoutCommand}"
                                ToolTip="Logout"/>
                    </StackPanel>

                    <Separator Width="500"/>

                    <!-- Password section -->
                    <StackPanel HorizontalAlignment="Center"
                                Visibility="{Binding IsAccountMode, Converter={StaticResource BoolToVisibility}}">
                        
                        <TextBlock Text="Current password"/>
                        <PasswordBox PasswordChanged="CurrentPasswordBox_PasswordChanged"/>

                        <TextBlock Text="New password"/>
                        <PasswordBox x:Name="NewPasswordBox" PasswordChanged="NewPasswordBox_PasswordChanged"/>

                        <TextBlock Text="Confirm new password"/>
                        <PasswordBox x:Name="ConfirmPasswordBox" PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>

                        <Button Content="Change password" Command="{Binding ChangePasswordCommand}"/>

                        <Separator Width="500"/>
                    </StackPanel>
                    
                    <!-- Library -->
                    <StackPanel HorizontalAlignment="Center" >

                        <!-- Title -->
                        <TextBlock Text="Library"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource SubtitleText}"/>
   
                        <!-- Buttons -->
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center">

                            <Button Content="Export"
                                    Click="ExportLibrary_Click"
                                    ToolTip="Export"/>

                            <Button Content="Import"
                                    Click="ImportLibrary_Click"
                                    ToolTip="Import"/>
                            
                        </StackPanel>
                        
                        <Separator Width="500"/>

                    </StackPanel>

                    <!-- Appearance -->
                    <StackPanel Width="400"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0">

                        <TextBlock Text="Appearance"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"
                                   Style="{StaticResource SubtitleText}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Theme"
                                       VerticalAlignment="Center"/>

                            <ComboBox Grid.Column="1"
                                      Width="200"
                                      HorizontalAlignment="Right"
                                      ItemsSource="{Binding AvailableThemes}"
                                      SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                    </StackPanel>

                    <!-- Transparency -->
                    <StackPanel HorizontalAlignment="Center" 
                                Width="400"
                                Margin="0,8,0,0">
                        <!-- Main Window Opacity -->
                        <TextBlock Text="Main Window Opacity"
                                   HorizontalAlignment="Left"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    Minimum="1" Maximum="100"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding MainWindowOpacityPercent, Mode=TwoWay}"
                                    IsMoveToPointEnabled="True"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding MainWindowOpacityPercent, StringFormat='{}{0:0}%'}"
                                       VerticalAlignment="Center"
                                       Width="48"
                                       TextAlignment="Right"
                                       Foreground="{DynamicResource DisabledTextColor}"/>
                        </Grid>

                        <!-- Mini Player Opacity -->
                        <TextBlock Text="Mini Player Opacity"
                                   HorizontalAlignment="Left"
                                   Margin="0,8,0,0"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    Minimum="1" Maximum="100"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding MiniWindowOpacityPercent, Mode=TwoWay}"
                                    IsMoveToPointEnabled="True"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding MiniWindowOpacityPercent, StringFormat='{}{0:0}%'}"
                                       VerticalAlignment="Center"
                                       Width="48"
                                       TextAlignment="Right"
                                       Foreground="{DynamicResource DisabledTextColor}"/>
                        </Grid>
                        
                    </StackPanel>

                    <Separator Width="500"/>

                    <!-- Local folders -->
                    <TextBlock Text="Local Folders"
                               HorizontalAlignment="Center"
                               Style="{StaticResource SubtitleText}"/>

                    <StackPanel Width="500" HorizontalAlignment="Center" Margin="0,4,0,0">

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Music"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding MusicFolderPath}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="8,0"
                                       Foreground="{DynamicResource DisabledTextColor}"/>
                            <Button Grid.Column="2"
                                    Content="📁"
                                    Command="{Binding OpenFolderCommand}"
                                    CommandParameter="{Binding MusicFolderPath}"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="30" Height="30"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="App data"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AppDataFolderPath}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="8,0"
                                       Foreground="{DynamicResource DisabledTextColor}"/>
                            <Button Grid.Column="2"
                                    Content="📁"
                                    Command="{Binding OpenFolderCommand}"
                                    CommandParameter="{Binding AppDataFolderPath}"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="30" Height="30"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Themes"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ThemesFolderPath}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="8,0"
                                       Foreground="{DynamicResource DisabledTextColor}"/>
                            <Button Grid.Column="2"
                                    Content="📁"
                                    Command="{Binding OpenFolderCommand}"
                                    CommandParameter="{Binding ThemesFolderPath}"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="30" Height="30"/>
                        </Grid>
                        
                        <Separator Width="500"/>
                        
                    </StackPanel>


                    <!-- Updates -->
                    <TextBlock Text="Updates"
                               HorizontalAlignment="Center"
                               Style="{StaticResource SubtitleText}"/>
                    <StackPanel Width="400"
                                HorizontalAlignment="Center"
                                Margin="0,4,0,0"
                                Visibility="{Binding IsUpdateInstalled, Converter={StaticResource BoolToVisibility}}">
                        
                        <!-- Auto Update Checkbox -->
                        <CheckBox Content="Automatically update on close"
                                  IsChecked="{Binding AutoUpdateEnabled, Mode=TwoWay}"
                                  Foreground="{DynamicResource LightTextColor}"
                                  HorizontalAlignment="Center"
                                  Margin="0,4,0,8"
                                  ToolTip="When enabled, the app checks for updates on startup, downloads them in the background, and installs them silently when you close the app. The new version runs next launch."/>

                        <!-- Update Channels -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,8">
                            <RadioButton Content="Stable Channel"
                                         GroupName="UpdateChannel"
                                         Margin="0,0,16,0"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource LightTextColor}"
                                         IsChecked="{Binding UseStableChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Updates include only stable releases."/>
                            <RadioButton Content="Pre-release Channel"
                                         GroupName="UpdateChannel"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource LightTextColor}"
                                         IsChecked="{Binding UsePrereleaseChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Updates include pre-release builds."/>
                        </StackPanel>

                        <!-- Check for Updates Button -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Check for updates"
                                    Command="{Binding CheckForUpdatesCommand}"/>
                            <Button Content="Update"
                                    Command="{Binding ApplyUpdateCommand}"
                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding AvailableVersionText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningTextColor}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUpdate}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding UpdateStatus}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource DisabledTextColor}"/>
                    </StackPanel>

                    <!-- Update Unavailable in Dev -->
                    <TextBlock Text="Updates are unavailable in development builds."
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource DisabledTextColor}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUpdateInstalled}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- App Version -->
                    <TextBlock Text="{Binding AppVersion}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,12"
                               Foreground="{DynamicResource DisabledTextColor}"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>