<UserControl x:Class="Ognia.Wpf.Views.MainPane.PlaylistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ognia.Wpf.Views.MainPane">
    <Grid>
        <DockPanel Margin="10">

            <!-- Playlist header -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="120" Height="120" CornerRadius="8"
                            ClipToBounds="True"
                            Background="{DynamicResource TextBoxBackgroundColor}">
                        <Image Source="{Binding Session.SelectedPlaylist.CachedCoverPath, Converter={StaticResource StringToImageSource}}"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>

                    <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Playlist Title -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Session.SelectedPlaylist.Name}"
                                       HorizontalAlignment="Left">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="18"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource LightTextColor}"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRenameOpen}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsRenameOpen, Converter={StaticResource BoolToVisibility}}">
                                <TextBox Text="{Binding RenameInput, UpdateSourceTrigger=PropertyChanged}"
                                         Width="300"
                                         VerticalAlignment="Center"/>
                                <Button Content="✓"
                                        Command="{Binding ConfirmRenameCommand}"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="Save name"/>
                                <Button Content="✕"
                                        Command="{Binding CancelRenameCommand}"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="Cancel rename"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="✎"
                                    ToolTip="Rename playlist"
                                    Width="30"
                                    Height="30"
                                    Margin="5,0,0,0"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding RenamePlaylistCommand}">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource IconButton}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRenameOpen}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- Playlist Track Count -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Session.SelectedPlaylist.PlaylistTracksCount, StringFormat='{}{0} tracks'}"
                                   Foreground="{DynamicResource DisabledTextColor}"
                                   HorizontalAlignment="Left"
                                   Margin="0,0,0,4"/>

                        <!-- Playlist Actions -->
                        <Grid Grid.Row="2">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRenameOpen}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAddTrackOpen}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Buttons -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">

                                <!-- Play -->
                                <Button Content="▶"
                                        Command="{Binding PlayPlaylistCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Width="40" Height="40"/>

                                <!-- Open Playlist Folder -->
                                <Button Content="📁"
                                        Command="{Binding OpenFolderCommand}"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="Open playlist folder"/>

                                <!-- Download All Tracks -->
                                <Button Content="🡻"
                                        Command="{Binding Session.Download.DownloadAllCommand}"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="Download all tracks in this playlist"/>

                                <!-- Remove All Downloaded Tracks -->
                                <Button Content="━"
                                        Command="{Binding Session.Download.RemoveAllDownloadsCommand}"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="Remove all downloads in this playlist"/>

                                <!-- Shuffle Toggle -->
                                <Button Content="{Binding ShuffleLabel}"
                                        Command="{Binding ToggleShuffleCommand}"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="Toggle shuffle"/>

                                <!-- Search / Filter -->
                                <Button Content="🔎"
                                        Command="{Binding ToggleFilterCommand}"
                                        ToolTip="Filter tracks in this playlist">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource IconButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Session.PlaylistFilterOpen}"
                                                             Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource PressedButtonBackgroundColor}"/>
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource HoverTextColor}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                
                            </StackPanel>

                            <!-- Right Buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">

                                <!-- Add Track to Playlist -->
                                <Button Content="➕"
                                        Command="{Binding AddTrackCommand}"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="Add track to playlist"/>

                                <!-- Delete Playlist -->
                                <Button Content="🗙"
                                        Command="{Binding DeletePlaylistCommand}"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="Delete playlist"/>

                            </StackPanel>
                            
                        </Grid>

                        <!-- Add Track Prompt -->
                        <StackPanel Grid.Row="4" Margin="0,5,0,0"
                                    Visibility="{Binding IsAddTrackOpen, Converter={StaticResource BoolToVisibility}}">
                            
                            <TextBlock Text="Track or playlist URL"/>
                            
                            <StackPanel Orientation="Horizontal">

                                <!-- Track URL to Add -->
                                <TextBox Text="{Binding AddTrackUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Width="300"/>

                                <!-- Confirm -->
                                <Button Content="✓"
                                        Command="{Binding ConfirmAddTrackCommand}"
                                        Height="40" Width="40"/>

                                <!-- Cancel -->
                                <Button Content="✕"
                                        Command="{Binding CancelAddTrackCommand}"
                                        Height="40" Width="40"/>
                                
                            </StackPanel>
                            
                        </StackPanel>

                        <!-- Filter Playlist Prompt -->
                        <StackPanel Grid.Row="5" Margin="0,5,0,0"
                                    Orientation="Horizontal"
                                    Visibility="{Binding Session.PlaylistFilterOpen, Converter={StaticResource BoolToVisibility}}">

                            <!-- Filter Textbox -->
                            <TextBox Text="{Binding Session.PlaylistFilter, UpdateSourceTrigger=PropertyChanged}"
                                     Width="300"
                                     ToolTip="Filter tracks by name"/>

                            <!-- Clear -->
                            <Button Content="✕"
                                    Command="{Binding ClearFilterCommand}"
                                    Style="{StaticResource IconButton}"
                                    IsEnabled="{Binding Session.IsFilterActive}"
                                    ToolTip="Clear filter"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Track List -->
            <ListBox x:Name="TracksList"
                     ItemsSource="{Binding Session.FilteredPlaylistTracks}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="TracksList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="TracksList_PreviewMouseMove"
                     DragOver="TracksList_DragOver"
                     Drop="TracksList_Drop"
                     SelectionMode="Multiple">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Grid Height="45"
                                  HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Playlist actions -->
                                <Button x:Name="PlaylistButton"
                                        Grid.Column="6"
                                        Width="30"
                                        Background="Transparent"
                                        FontWeight="Light"
                                        BorderThickness="0"
                                        ToolTip="Add or remove this track from playlists"
                                        Command="{Binding OpenPlaylistPickerCommand}"
                                        Style="{StaticResource IconButton}">
                                    <TextBlock Text="ooo"
                                               Foreground="{DynamicResource AlternateTextColor}"/>
                                </Button>

                                <Popup PlacementTarget="{Binding ElementName=PlaylistButton}"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       IsOpen="{Binding IsPlaylistPickerOpen, Mode=TwoWay}">
                                    <Border Background="{DynamicResource SidebarBackgroundColor}"
                                            BorderBrush="{DynamicResource ButtonBorderBrushColor}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8"
                                            Width="240">
                                        <StackPanel>
                                            <TextBlock Text="Playlists"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,6"/>
                                            <Separator Margin="0,0,0,6"/>

                                            <TextBlock Text="Remove From"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding ExistingPlaylists}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Name}"
                                                                       VerticalAlignment="Center"/>
                                                            <CheckBox Grid.Column="1"
                                                                      IsChecked="{Binding IsInPlaylist, Mode=OneWay}"
                                                                      Command="{Binding DataContext.TogglePlaylistCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      CommandParameter="{Binding}"
                                                                      VerticalAlignment="Center"
                                                                      Margin="8,0,0,0"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Separator Margin="0,6"/>

                                            <TextBlock Text="Add to"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding OtherPlaylists}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Name}"
                                                                       VerticalAlignment="Center"/>
                                                            <CheckBox Grid.Column="1"
                                                                      IsChecked="{Binding IsInPlaylist, Mode=OneWay}"
                                                                      Command="{Binding DataContext.TogglePlaylistCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      CommandParameter="{Binding}"
                                                                      VerticalAlignment="Center"
                                                                      Margin="8,0,0,0"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="Loading..."
                                                       Foreground="{DynamicResource DisabledTextColor}"
                                                       Visibility="{Binding IsLoadingPlaylists, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <!-- Checkbox -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,5,0"
                                          ToolTip="Select track">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox"
                                               BasedOn="{StaticResource {x:Type CheckBox}}">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                             Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>

                                <!-- Display Order -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayOrder}"
                                           Foreground="{DynamicResource DisabledTextColor}"
                                           VerticalAlignment="Center"/>
                                
                                <!-- Download Indicator -->
                                <TextBlock Grid.Column="2" 
                                           Text="{Binding DownloadedLabel}" 
                                           Foreground="{DynamicResource SuccessTextColor}" 
                                           Margin="5,0,0,0"
                                           VerticalAlignment="Center"/>

                                <!-- Track Cover Image -->
                                <Border Grid.Column="3" 
                                        Width="40" Height="40" 
                                        VerticalAlignment="Center" 
                                        HorizontalAlignment="Left"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding ThumbnailPath, Converter={StaticResource StringToImageSource}}"
                                               Stretch="UniformToFill"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                        <Button Content="▶"
                                                Command="{Binding PlayCommand}"
                                                ToolTip="Play this track">
                                            <Button.Style>
                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Opacity" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
                                                                     Value="True">
                                                            <Setter Property="Opacity" Value="1"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Track Name -->
                                <TextBlock Grid.Column="4" 
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Text="{Binding Name}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource AlternateTextColor}"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource LightTextColor}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                             Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource HoverTextColor}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Track Duration -->
                                <TextBlock Grid.Column="5" Text="{Binding Duration}"
                                           Foreground="{DynamicResource DisabledTextColor}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                            </Grid>
                            
                            <!--- Bottom Separator -->
                            <Rectangle 
                                Height="1" 
                                Opacity="0.25"
                                Fill="{DynamicResource SeparatorBackgroundColor}"/>
                            
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>