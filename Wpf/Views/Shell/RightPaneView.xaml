<UserControl x:Class="Ognia.Wpf.Views.Shell.RightPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PaneBorder}"
            CornerRadius="10" Margin="10" Padding="10"
            ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                <GradientStop Color="{DynamicResource BackgroundColor.Color}" Offset="0"/>
                <GradientStop Color="{DynamicResource GradientBackgroundColor.Color}" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0"
                    Content="✕"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="30" Height="30"
                    FontSize="14"
                    Cursor="Hand"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="CloseButton_Click"
                    ToolTip="Close panel">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                        <Setter Property="Foreground" Value="{DynamicResource LightTextColor}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource HoverTextColor}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <ContentControl Grid.Row="1" x:Name="HostContent"/>
        </Grid>
    </Border>
</UserControl>