<UserControl x:Class="Ognia.Wpf.Views.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PaneBorder}">
        <Grid Style="{StaticResource PaneContent}">

            <!-- Landing: big icon + choice -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="500"
                        Visibility="{Binding ShowLanding, Converter={StaticResource BoolToVisibility}}">

                <Image Source="/Assets/Brand/Logo/Ognia.png"
                       Width="300" Height="300"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <Button Content="Continue as Guest"
                        Command="{Binding GuestCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="240"
                        HorizontalAlignment="Center"/>

                <Button Content="Log In"
                        Command="{Binding ShowLoginFormCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="240"
                        HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Login / Register form -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MinWidth="280"
                        MaxWidth="400"
                        Visibility="{Binding ShowLoginForm, Converter={StaticResource BoolToVisibility}}">

                <Button Content="↩"
                        Command="{Binding BackToLandingCommand}"
                        HorizontalAlignment="Left"
                        Style="{StaticResource IconButton}"
                        Width="40" Height="40"
                        ToolTip="Back"/>
                
                <TextBlock Text="Log In" Style="{StaticResource TitleText}"/>

                <TextBlock Text="Email" Style="{StaticResource PrimaryTextBlock}"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Password" Style="{StaticResource PrimaryTextBlock}"/>
                <PasswordBox x:Name="PasswordBox"
                             PasswordChanged="PasswordBox_PasswordChanged"/>

                <Button Content="Log in"
                        Command="{Binding LoginCommand}"
                        Style="{StaticResource PrimaryButton}"/>
                <TextBlock>
                    <Hyperlink Command="{Binding ForgotPasswordCommand}">
                        <TextBlock Text="Forgot Password?" Style="{StaticResource PrimaryTextBlock}"/>
                    </Hyperlink>
                </TextBlock>

                <TextBlock Text="{Binding LoginStatus}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource ErrorColor}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoginError}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource LightTextColor}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Separator/>

                <TextBlock Text="Create account" Style="{StaticResource TitleText}"/>

                <TextBlock Text="Email" Style="{StaticResource PrimaryTextBlock}"/>
                <TextBox Text="{Binding RegEmail, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Password" Style="{StaticResource PrimaryTextBlock}"/>
                <PasswordBox x:Name="RegPasswordBox"
                             PasswordChanged="RegPasswordBox_PasswordChanged"/>

                <Button Content="Sign up"
                        Command="{Binding SignUpCommand}"
                        Style="{StaticResource PrimaryButton}"/>

                <TextBlock Text="{Binding RegisterStatus}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessColor}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRegisterError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorColor}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>